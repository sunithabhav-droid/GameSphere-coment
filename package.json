{
  "name": "gamesphere",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name gamesphere",
    "deploy:game-host": "wrangler deploy --config wrangler.games.jsonc",
    "dev": "npm run build && wrangler pages dev dist",
    "test": "node --test"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.3.0",
    "fflate": "^0.8.2",
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^4.40.0"
  }
}
