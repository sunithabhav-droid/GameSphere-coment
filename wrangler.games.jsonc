{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamesphere-game-host",
  "main": "./workers/game-host.js",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "GAMES_BUCKET",
      "bucket_name": "gamesphere-games"
    }
  ]
}
